# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database config
db.properties

# Scripts (Database init & check)
/scripts/

# pipeline-visual.test.ts가 매 실행마다 재생성하는 diff 시각화 산출물
test/fixtures/diff-output-*.png

# 로컬 개발 전용 Supabase 스택 (supabase init으로 생성, 팀 공유 대상 아님)
/supabase/
# 단, 마이그레이션 파일은 버전 제어에 포함
!/supabase/migrations/
!/supabase/migrations/**

# playwright MCP 세션 산출물 (콘솔 로그, 스냅샷)
.playwright-mcp/
