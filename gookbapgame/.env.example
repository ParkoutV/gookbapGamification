SUPABASE_URL=
SUPABASE_ANON_KEY=
GENERATE_UNIFIED_API_URL=
NICKNAME_ASSIGN_API_URL=
# 카드 뽑기(gookbapanalyze의 /api/gatcha/draw). 로컬 폴백이 없다 —
# 미설정이면 뽑기가 통째로 실패한다.
GATCHA_DRAW_API_URL=
# 온라인몰 전용 쿠폰 발급(gookbapanalyze의 /api/web-coupons/assign).
# 설문 phase 1 최초 응답자에게 100% 확정 지급되며, 자격 검증은 서버가 한다.
# 미설정이면 발급만 조용히 건너뛴다 — 설문·뽑기 흐름은 그대로 진행된다.
WEB_COUPON_ASSIGN_API_URL=
# 지점을 특정할 수 없는 유입(온라인 광고, ?q= 없는 기본 URL)이 쓸 공유 트랙 id.
# '온라인' 지점의 is_shared=true 트랙을 넣는다. 미설정이면 그 경로에서는
# '친구 초대하기' 버튼이 뜨지 않는다(공유 유입 KPI 포기).
#
# 프로덕션 값은 Vercel 환경변수에만 둔다 — 저쪽에서 바뀔 수 있어서 리포에 박으면
# 죽은 코드가 남는다(2026-08-10에 실제로 한 번 교체됐다).
# 로컬은 마이그레이션이 심는 더미 트랙을 쓴다: local-online-shared
FALLBACK_SHARED_TRACK_ID=
